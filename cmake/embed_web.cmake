# Generates a C++ translation unit that embeds every file under INPUT_DIR.
#
# Run with: cmake -DINPUT_DIR=... -DOUTPUT=... -P embed_web.cmake
#
# Files are stored as raw string literals. The delimiter below is rejected in
# any asset so a stray sequence can never truncate the literal.

if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "embed_web.cmake requires INPUT_DIR and OUTPUT")
endif()

file(GLOB_RECURSE asset_files LIST_DIRECTORIES false RELATIVE "${INPUT_DIR}" "${INPUT_DIR}/*")
list(SORT asset_files)

set(body "")
foreach(rel IN LISTS asset_files)
  file(READ "${INPUT_DIR}/${rel}" content)
  string(FIND "${content}" ")STRATA_WEB\"" bad)
  if(bad GREATER -1)
    message(FATAL_ERROR "Asset ${rel} contains the raw string delimiter")
  endif()
  if(content STREQUAL "")
    set(content " ")
  endif()
  string(APPEND body "    {\"/${rel}\",\n     R\"STRATA_WEB(${content})STRATA_WEB\"},\n")
endforeach()

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/embed_web.cmake. Do not edit.
#include \"web.hpp\"

#include <map>
#include <string>

namespace strata {

const std::map<std::string, std::string>& webAssets() {
  static const std::map<std::string, std::string> assets = {
${body}  };
  return assets;
}

}  // namespace strata
")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
